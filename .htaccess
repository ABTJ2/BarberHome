Options -Indexes
RewriteEngine On
RewriteRule ^(application|system|database|docs|tools)(/|$) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L,QSA]
<FilesMatch "^(\.env|composer\.(json|lock)|README.*|.*\.sql)$">
  Require all denied
</FilesMatch>
